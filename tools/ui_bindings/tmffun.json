        "Btn_MoveFavorites_Save": {
          "kind": "button",
          "text": "保存(&S)",
          "action": "save"
        },
        "Btn_MoveFavorites_Exit": {
          "kind": "button",
          "text": "退出(&E)",
          "action": "close"
        }
      }
    },
    "MlSkinTabSheet7": {
      "note": "转移虚拟内存：智能/指定盘符 + 大小（按物理内存倍数 或 固定值）",
      "controls": {
        "Rb_SmartMovePageFile": {
          "kind": "radio",
          "text": "智能转移",
          "group": "movePageFile",
          "binding": "optimization.pageFileSmart",
