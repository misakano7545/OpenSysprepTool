        "Lab_SmartMoveFavoritesTip": {
          "kind": "label",
          "text": "说明:自动扫描目标系统最大剩余容量的分区，如果条件不成立则不转移。"
        },
        "Lab_DiyMoveFavoritesTip": {
          "kind": "label",
          "text": "说明:转移到指定目录，如果条件不成立则执行智能转移目录机制。"
        },
        "Lab_MoveFavoritesPath": {
          "kind": "label",
          "text": "转移目录:"
        },
        "Ed_MoveFavorites_Path": {
          "kind": "edit",
          "text": "",
          "binding": "optimization.favoritesTarget"
        },
        "Btn_MoveFavorites_Open": {
          "kind": "button",
