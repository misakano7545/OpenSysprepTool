        },
        "Lab_Tip_MovePagefile": {
          "kind": "label",
          "text": "",
          "role": "status"
        },
        "Btn_MovePageFile_Save": {
          "kind": "button",
          "text": "保存(&S)",
          "action": "save"
        },
        "Btn_MovePageFile_Exit": {
          "kind": "button",
          "text": "退出(&E)",
          "action": "close"
        }
      }
