{
  "page": "system",
  "sheet": "MlSkinTabSheet1",
  "function": "systemPage",
  "hiddenGroups": [],
  "exclude": {
    "Mb_ScanOutList": {
      "kind": "control",
      "why": "体检结果的滚动容器，内容用 Lab_ScanResults 呈现"
    },
    "Btn_Repairend": {
      "kind": "control",
      "why": "一键修复的结果面板按钮，面板（Gb_Repairend）默认不显示，本轮不做该面板"
    },
    "Btn_help_V": {
      "kind": "control",
      "why": "帮助面板（Gb_HelpV）的切换按钮，面板默认不显示，本轮不做"
    },
    "Btn_Goback": {
      "kind": "control",
      "why": "帮助面板的返回按钮，随 Gb_HelpV 一起不做"
    },
    "Pic_helpv": {
      "kind": "control",
      "why": "帮助面板的图片，随 Gb_HelpV 一起不做"
    },
    "Pic_pedrive": {
      "kind": "control",
      "why": "SRS 面板的盘符示意图，随 Gb_SRS 一起不做"
    },
    "ScanBar1": {
      "kind": "control",
      "why": "体检进度条的滚动条内部件"
    }
  },
