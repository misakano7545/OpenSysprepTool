    "Pic_Osname": {
      "kind": "image",
      "label": "系统图示",
      "note": "DFM 16x16 图标，图案自绘"
    },
    "Pic_Csize": {
      "kind": "image",
      "label": "分区图示",
      "note": "DFM 16x16 图标，图案自绘"
    },
    "Pic_SysprepSupportok": {
      "kind": "image",
      "label": "支持封装",
      "note": "16x16 状态图标，自绘"
    },
    "Pic_SysprepSupportno": {
      "kind": "image",
      "label": "不支持封装",
      "note": "16x16 状态图标，自绘"
    },
    "Lab_Osnamev": {
      "kind": "info",
      "valueSource": "osName"
    },
    "Lab_Osntverv": {
      "kind": "info",
      "valueSource": "report.os.version.empty() ? std::string(\"未知\") : report.os.version"
    },
    "Lab_SysprepSupportv": {
      "kind": "info",
